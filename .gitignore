# dependencias y builds
node_modules
dist-app/
build/installer-config.nsh
web/dist/

# contenido generado/sincronizado en runtime (Supa es la fuente de verdad)
workspace/skills/
workspace/uploads/
workspace/lab-drafts/
workspace/modes/*/skills
workspace/.claude-mcp.json
workspace/.copilot-mcp.json

# sistema y logs
.DS_Store
*.log
nohup.out

# repositorio local de incidencias: datos de la operación, nunca al repositorio
*.sqlite
*.sqlite.tmp
*.sqlite-wal
*.sqlite-shm

# configuración local de agentes e IDE: skills, credenciales y MCP de cada equipo
.agents/
.claude/
.idea/
.mcp.json
# Desinstalar SIA.exe: lo genera setup/scripts/desinstalador.mjs
build/Desinstalar SIA.exe
