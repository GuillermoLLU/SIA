{
  "name": "sia",
  "productName": "SIA",
  "version": "1.1.0",
  "description": "Sistema de IA para equipos: chat con IA, conocimiento y skills",
  "author": "Indra Group",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node dev.mjs",
    "test": "node --test \"server/**/*.test.js\" \"web/src/**/*.test.js\" \"build/**/*.test.js\"",
    "test:rls": "scripts/rls-tests/run.sh",
    "test:platform": "scripts/platform-tests/run.sh",
    "app": "electron .",
    "build:web": "cd web && npm run build",
    "dist": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && node scripts/installer-config.mjs && electron-builder --win",
    "dist:setup": "node setup/scripts/desinstalador.mjs && npm run dist:win && node setup/scripts/empaquetar.mjs",
    "dist:setup:mac": "npm run dist && node setup/scripts/empaquetar.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@xenova/transformers": "^2.17.2",
    "snowflake-sdk": "^3.4.1",
    "undici": "^6.0.0",
    "ws": "^8.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.itx.sia",
    "productName": "SIA",
    "extraMetadata": {
      "description": "SIA"
    },
    "asar": true,
    "publish": null,
    "npmRebuild": false,
    "directories": {
      "output": "dist-app"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "files": [
      "electron/**",
      "server/**",
      "!server/**/*.test.js",
      "mcp/**",
      "web/dist/**",
      "supabase-schema.sql",
      "sia-instance.json",
      "skills/common/**",
      "workspace/modes/auto/AGENTS.md",
      "workspace/modes/demand/AGENTS.md",
      "!mcp/seed-skills.mjs",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.{ts,mts,cts}",
      "!**/node_modules/@xenova/transformers/dist/**",
      "!**/node_modules/onnxruntime-web/dist/*.wasm",
      "!**/node_modules/onnxruntime-web/dist/*.min.js",
      "!**/node_modules/onnxruntime-web/dist/ort.js",
      "!**/node_modules/onnxruntime-web/dist/ort-web.js",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/!(${platform})/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/${platform}/!(${arch})/**",
      "!**/node_modules/sharp/{src,deps}/**",
      "!**/node_modules/@azure/msal-browser/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp"
    }
  }
}
