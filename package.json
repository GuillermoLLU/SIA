{
  "name": "sia",
  "productName": "SIA",
  "version": "1.0.0",
  "description": "SIA: sistema de uso de IA para equipos — terminal de IA + conocimiento + skills",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node dev.mjs",
    "test": "node --test 'server/**/*.test.js' 'web/src/**/*.test.js'",
    "test:rls": "scripts/rls-tests/run.sh",
    "test:platform": "scripts/platform-tests/run.sh",
    "app": "electron .",
    "build:web": "cd web && npm run build",
    "dist": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@xenova/transformers": "^2.17.2",
    "node-pty": "^1.1.0",
    "undici": "^6.0.0",
    "ws": "^8.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.itx.sia",
    "productName": "SIA",
    "asar": false,
    "publish": null,
    "npmRebuild": false,
    "directories": {
      "output": "dist-app"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "files": [
      "electron/**",
      "server/**",
      "!server/**/*.test.js",
      "mcp/**",
      "web/dist/**",
      "supabase-schema.sql",
      "sia-instance.json",
      "skills/common/**",
      "workspace/modes/auto/CLAUDE.md",
      "workspace/modes/auto/AGENTS.md",
      "workspace/modes/demand/CLAUDE.md",
      "workspace/modes/demand/AGENTS.md",
      "!**/.claude-mcp.json",
      "!**/.copilot-mcp.json",
      "!mcp/seed-skills.mjs"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  }
}
